# Optional. Without it the app uses OSRM + Nominatim, which need no signup.
# Free key: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Required in production.
SECRET_KEY=change-me
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Set automatically when you attach Neon Postgres in the Vercel dashboard.
# Local development falls back to SQLite when this is unset.
DATABASE_URL=
