# Optional. Without it the app uses OSRM + Nominatim, which need no signup.
# With it, OpenRouteService handles geocoding (better rural place names, no
# rate limit); OSRM still handles routing, because ORS's truck profile returns
# durations around 40% slow. See trips/services/routing.py.
# Free key: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Only used when ORS is the routing fallback. driving-hgv honours truck
# restrictions but is much slower than reality; driving-car matches real
# durations. Default: driving-car
ORS_PROFILE=

# Required in production.
SECRET_KEY=change-me
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Set automatically when you attach Neon Postgres in the Vercel dashboard.
# Local development falls back to SQLite when this is unset.
DATABASE_URL=